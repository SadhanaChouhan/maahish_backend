# =============================================================================
# Maahish Production Environment — copy to .env.prod and fill in your values
# =============================================================================
# Usage (Linux/macOS):
#   cp env.prod.example .env.prod
#   set -a && source .env.prod && set +a && java -jar target/maahish-backend-*.jar
#
# Usage (Windows PowerShell):
#   Copy-Item env.prod.example .env.prod
#   Get-Content .env.prod | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process') } }
#   $env:SPRING_PROFILES_ACTIVE='prod'; java -jar target\maahish-backend-*.jar
#
# NEVER commit .env.prod — it contains secrets.

SPRING_PROFILES_ACTIVE=prod

# --- Database (MySQL 8+) ---
DATABASE_URL=jdbc:mysql://YOUR_DB_HOST:3306/maahish_db?useSSL=true&serverTimezone=Asia/Kolkata&characterEncoding=UTF-8
DATABASE_USERNAME=YOUR_DB_USER
DATABASE_PASSWORD=YOUR_DB_PASSWORD

# --- Redis (required in production) ---
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# --- JWT (min 32 random characters) ---
JWT_SECRET=YOUR_256_BIT_RANDOM_SECRET_CHANGE_ME

# --- CORS (comma-separated, no trailing slash) ---
CORS_ALLOWED_ORIGINS=https://www.themaahish.com,https://themaahish.com

# --- Auth cookies (use None for cross-origin API; Lax if same-origin /api proxy) ---
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=None

# --- Razorpay LIVE keys ---
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_LIVE_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# --- Email (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=YOUR_APP_PASSWORD

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
